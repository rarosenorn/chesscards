                  "e5",
                  "Nf3",
                  "d6"
                ],
                "solutionArrows": {
                  "4": [
                    [
                      "success",
                      "d2",
                      "d4"
                    ]
                  ]
                }
              }
            ]
          },
          "back": {
            "text": "[3.d4], the strongest move. White's main candidates are [3.Nc3], [3.Bc4] and [3.d4]; the first two are good moves that follow basic principles, but the immediate [3.d4] attacks Black's e-pawn and exerts more pressure, often leading to an inferior reply. We also open the center and prepare the development of the c1-bishop."
          }
        },
        {
          "id": "phil-bg4-vs-nc6",
          "front": {
            "text": "What do you play and why?",
            "boards": [
              {
                "fen": "rnbqkbnr/pppppppp/8/8/8/8/PPPPPPPP/RNBQKBNR w KQkq - 0 1",
                "orientation": "w",
                "moves": [
