                  "e5",
                  "Nf3",
                  "d6",
                  "d4",
                  "Nc6"
                ],
                "solutionArrows": {
                  "6": [
                    [
                      "success",
                      "b1",
                      "c3"
                    ]
                  ]
                }
              }
            ]
          },
          "back": {
            "text": "[4.Nc3], which fits best to our concept and reaches the position we investigate via [1.e4 e5 2.Nf3 Nc6 3.Nc3 d6 4.d4]. The logical [4.Bc4] and [4.Bb5] are good too."
          }
        },
